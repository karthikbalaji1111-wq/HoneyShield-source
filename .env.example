# HoneyShield environment template. Copy to a file OUTSIDE the repository (e.g. /etc/honeyshield/prod.env,
# mode 600) and run:  docker compose --env-file /etc/honeyshield/prod.env up -d
# Never commit a populated copy. Every secret below must be generated independently:
#     openssl rand -hex 32
# docker compose refuses to start when a required value is missing. See docs/environment-configuration.md.

APP_ENV=production
LOG_LEVEL=INFO

# ---------------------------------------------------------------- hostnames (both required)
# Operator API, console and live streams.
HS_CONTROL_HOST=
# Public decoy ingestion. Embedded in every generated artifact as https://<HS_INGEST_HOST>.
# Must NOT be a customer domain and must differ from HS_CONTROL_HOST.
HS_INGEST_HOST=

# ---------------------------------------------------------------- secrets (all required)
JWT_SECRET_KEY=
# Master key for customer-integration signing secrets, webhook signing secrets and evidence
# checkpoint signatures. Must differ from JWT_SECRET_KEY. Rotating it invalidates every
# integration credential and webhook secret.
INTEGRATION_SIGNING_KEY=
# Operator MFA (TOTP). Derivation key for every user's TOTP secret; must differ from the two keys
# above. Rotating it invalidates all enrolments (admins then reset MFA and users re-enrol).
MFA_SECRET_KEY=
# Roles that must use MFA. Empty = SYSTEM_ADMIN,TENANT_ADMIN in production. "none" = no requirement
# (a documented risk acceptance).
MFA_REQUIRED_ROLES=
# Password for the internal Redis (shared rate limits + live stream across backend replicas).
REDIS_PASSWORD=
# Backend API replicas behind nginx (each runs one uvicorn worker). 2+ for availability.
HS_BACKEND_REPLICAS=2
# Optional: bearer token for GET /metrics on the control host. Unset = endpoint disabled.
METRICS_TOKEN=

# ---------------------------------------------------------------- alert channels (optional)
# EMAIL destinations (mailto:...) are sent through this SMTP relay. Unset SMTP_HOST = EMAIL off.
# SMTP_SECURITY: starttls (587) or tls (465); "none" is refused in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Self-hosted only: private networks a SIEM or webhook receiver may live on, e.g. 10.20.0.0/16.
# Loopback, link-local and metadata addresses stay refused. Leave empty for multi-tenant SaaS.
ALERT_ALLOWED_PRIVATE_CIDRS=

# ---------------------------------------------------------------- single sign-on (optional)
# OpenID Connect (Okta, Microsoft Entra ID, Google Workspace, Keycloak, Auth0...). Users must
# already exist in HoneyShield; they are matched by email. See docs/sso.md.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Register exactly this redirect URI at the IdP:
OIDC_REDIRECT_URI=https://app.example.com/auth/oidc/callback
OIDC_DISPLAY_NAME=Single sign-on
# Entra ID without an email claim: OIDC_EMAIL_CLAIM=preferred_username, OIDC_REQUIRE_EMAIL_VERIFIED=false
OIDC_EMAIL_CLAIM=email
OIDC_REQUIRE_EMAIL_VERIFIED=true
# amr_claim: SSO counts as MFA only if the ID token's amr says so. trust_idp: the IdP always enforces MFA.
OIDC_MFA=amr_claim

# ---------------------------------------------------------------- WORM evidence checkpoints
# Strongly recommended in production: an S3 bucket created WITH Object Lock enabled. Every signed
# checkpoint is uploaded write-once (COMPLIANCE mode cannot be shortened or removed, even by the
# account root). The key needs only s3:PutObject, s3:PutObjectRetention, s3:GetObject and
# s3:ListBucket on that bucket - no delete. Only the checkpointer container receives these.
EVIDENCE_S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
EVIDENCE_S3_BUCKET=
EVIDENCE_S3_REGION=us-east-1
EVIDENCE_S3_ACCESS_KEY_ID=
EVIDENCE_S3_SECRET_ACCESS_KEY=
EVIDENCE_S3_PREFIX=checkpoints/
EVIDENCE_S3_RETENTION_DAYS=400
EVIDENCE_S3_LOCK_MODE=COMPLIANCE

# ---------------------------------------------------------------- retention (maintenance job)
# Days to keep detection events / audit records; 0 = forever, else >= 30. Older data is archived
# write-once (S3 archives/ prefix, or the evidence_archive volume) and then purged by
#   docker compose --profile maintenance run --rm retention
EVENT_RETENTION_DAYS=0
AUDIT_RETENTION_DAYS=0

# ---------------------------------------------------------------- database identities (HONEY-002)
POSTGRES_DB=honeyshield
# Bootstrap superuser: used only by the postgres container's first-start init script.
POSTGRES_BOOTSTRAP_USER=postgres
POSTGRES_BOOTSTRAP_PASSWORD=
# Schema owner: runs migrations and the grant step (migrate service only).
HS_OWNER_DB_USER=honeyshield_owner
HS_OWNER_DB_PASSWORD=
# Runtime role: what the API, worker and checkpointer connect as. Owns nothing.
HS_APP_DB_USER=honeyshield_app
HS_APP_DB_PASSWORD=
# The API refuses to start if its database role is privileged. Keep true in production.
ENFORCE_DB_LEAST_PRIVILEGE=true

# ---------------------------------------------------------------- edge (nginx)
# Production: NGINX_BIND_ADDRESS=0.0.0.0, NGINX_HTTP_PORT=80, NGINX_TLS_PORT=443.
NGINX_BIND_ADDRESS=127.0.0.1
NGINX_HTTP_PORT=8080
NGINX_TLS_PORT=8443
# Certificate files inside ./proxy/certs (e.g. from certbot). One SAN certificate may serve both hosts.
HS_CONTROL_CERT=server.crt
HS_CONTROL_KEY=server.key
HS_INGEST_CERT=server.crt
HS_INGEST_KEY=server.key
# Edge request rates per client IP (requests/second, with bursts configured in the template).
HS_EDGE_INGEST_RPS=20
HS_EDGE_HOOK_RPS=50
HS_EDGE_API_RPS=30
# Internal network and the nginx address the backend trusts for X-Forwarded-For (HONEY-005).
HS_INTERNAL_SUBNET=172.28.0.0/24
HS_NGINX_IP=172.28.0.10
# Containers get addresses from this part of the subnet only, so HS_NGINX_IP is never taken first.
# Keep it inside HS_INTERNAL_SUBNET and HS_NGINX_IP outside it (the installer derives it for a /24).
HS_INTERNAL_IP_RANGE=172.28.0.128/25

# ---------------------------------------------------------------- watchdog (docs/watchdog.md)
# A self-test decoy hit every 5 minutes plus health checks. Problems go to the webhook and/or email
# below; after every healthy check the heartbeat URL is requested, so an outside service such as
# Healthchecks.io warns you if the whole server stops. Set at least one notice channel.
WATCHDOG_NOTIFY_WEBHOOK_URL=
WATCHDOG_NOTIFY_EMAIL=
WATCHDOG_HEARTBEAT_URL=
WATCHDOG_HEARTBEAT_FAIL_URL=
# false while the certificate is self-signed; true once a real certificate is installed.
WATCHDOG_PROBE_VERIFY_TLS=true

# ---------------------------------------------------------------- backups (docs/backup-and-restore.md)
# Nightly pg_dump encrypted with age. The installer creates the key (backup-key.txt) and sets the
# public key here; keep backup-key.txt OFF this server. Empty: no backups.
BACKUP_AGE_RECIPIENTS=
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_LOCAL=3
# Off-site copy, any S3-compatible bucket (Oracle Object Storage, Backblaze B2, AWS S3, Cloudflare R2).
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_PREFIX=honeyshield-backups/
BACKUP_KEEP_DAYS=30

# ---------------------------------------------------------------- hardening (docs/decoy-paths.md)
# Your own decoy URL prefixes instead of /t/ /px/ /collect/, which any attacker who knows HoneyShield
# recognises. 1-3 segments of a-z, 0-9 and '-'. Old decoys keep working while HS_DECOY_LEGACY_PATHS=true.
HS_DECOY_LINK_PATH=t
HS_DECOY_PIXEL_PATH=px
HS_DECOY_COLLECT_PATH=collect
HS_DECOY_LEGACY_PATHS=true
# Only these addresses may open the console and API (comma-separated IPs/CIDRs). Empty: anyone.
# Decoys stay reachable from everywhere.
HS_CONTROL_ALLOW_CIDRS=

# ---------------------------------------------------------------- operations
# Released images instead of building on the host: HS_IMAGE_REGISTRY=ghcr.io/karthikbalaji1111-wq/
# (trailing slash) and HS_IMAGE_TAG=1.1.0, then `docker compose pull` and `up -d --no-build`.
HS_IMAGE_REGISTRY=
HS_IMAGE_TAG=local
# Seconds between signed evidence checkpoints (ship the evidence_checkpoints volume to WORM storage).
HS_CHECKPOINT_INTERVAL_SECONDS=900

# ---------------------------------------------------------------- CORS (F-014)
# The console is same-origin; leave empty unless another origin must call the API.
# Comma-separated list of allowed origins. Wildcard '*' is strictly forbidden.
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type,Accept,X-Request-ID
CORS_EXPOSE_HEADERS=X-Request-ID,X-Process-Time-Ms,Retry-After
CORS_MAX_AGE=600

# ---------------------------------------------------------------- security headers (F-015)
SECURITY_HEADERS_ENABLED=true
SECURITY_HEADERS_X_CONTENT_TYPE_OPTIONS=nosniff
SECURITY_HEADERS_X_FRAME_OPTIONS=DENY
SECURITY_HEADERS_REFERRER_POLICY=no-referrer
SECURITY_HEADERS_CSP=default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'
SECURITY_HEADERS_PERMISSIONS_POLICY=accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
SECURITY_HEADERS_CACHE_CONTROL=no-store
SECURITY_HEADERS_HSTS_ENABLED=true
SECURITY_HEADERS_HSTS_MAX_AGE=31536000
SECURITY_HEADERS_HSTS_INCLUDE_SUBDOMAINS=true
SECURITY_HEADERS_HSTS_PRELOAD=false
