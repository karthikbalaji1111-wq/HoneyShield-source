# HoneyShield edge configuration (rendered by the nginx image's envsubst at start-up).
#
# Two virtual hosts with different exposure:
#   ${HS_CONTROL_HOST}  operator API, auth, streaming          -> everything except ingest routes
#   ${HS_INGEST_HOST}   public decoy ingestion + integrations  -> ONLY the decoy prefixes + /integrations/v1/
#
# Decoy prefixes (HS_DECOY_*_PATH, default t / px / collect) and the operator-host allowlist
# (HS_CONTROL_ALLOW_CIDRS) are prepared by /docker-entrypoint.d/14-hs-edge-config.envsh.
# Any other Host is dropped (444). The backend enforces the same split (HostRoutingMiddleware).
#
# X-Forwarded-For is REPLACED with $remote_addr (never appended), so the backend sees exactly
# one hop written by this proxy. The backend trusts it only from this container's fixed IP.

server_tokens off;

# The backend is re-resolved every 10 s (a static upstream is resolved once at start-up and keeps
# pointing at a replaced container's old IP: 502 after every redeploy). The `resolver` directive
# is written by /docker-entrypoint.d/15-hs-resolver.sh from the container's own resolv.conf:
# Docker's embedded DNS under Compose, kube-dns under Kubernetes.

limit_req_zone  $binary_remote_addr zone=hs_ingest:10m  rate=${HS_EDGE_INGEST_RPS}r/s;
limit_req_zone  $binary_remote_addr zone=hs_hook:10m    rate=${HS_EDGE_HOOK_RPS}r/s;
limit_req_zone  $binary_remote_addr zone=hs_api:10m     rate=${HS_EDGE_API_RPS}r/s;
limit_req_zone  $binary_remote_addr zone=hs_login:10m   rate=10r/m;
# Separate budget so password-reset traffic can never use up an address's sign-in attempts.
limit_req_zone  $binary_remote_addr zone=hs_reset:10m   rate=10r/m;
limit_conn_zone $binary_remote_addr zone=hs_conn:10m;
limit_req_status 429;
limit_conn_status 429;

# Decoy hits the backend could not record (error, timeout, unreachable) are written here, one JSON
# line each, and replayed by the ingest-replay worker once the backend is back. Nothing else is
# logged on the ingest host. $request_id is also sent upstream as X-Request-ID, so a replayed hit
# that the backend had in fact stored is recognised and not stored twice.
log_format hs_capture escape=json '{"request_id":"$request_id","time":$msec,"remote_addr":"$remote_addr",'
    '"method":"$request_method","uri":"$uri","user_agent":"$http_user_agent","referer":"$http_referer",'
    '"accept":"$http_accept","accept_language":"$http_accept_language","upstream_status":"$upstream_status"}';

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# ---------------------------------------------------------------- unknown hosts
server {
    listen ${HS_HTTP_PORT} default_server;
    listen ${HS_TLS_PORT} ssl default_server;
    server_name _;
    ssl_certificate     /etc/nginx/certs/${HS_CONTROL_CERT};
    ssl_certificate_key /etc/nginx/certs/${HS_CONTROL_KEY};
    return 444;
}

# ---------------------------------------------------------------- plain HTTP
server {
    listen ${HS_HTTP_PORT};
    server_name ${HS_CONTROL_HOST} ${HS_INGEST_HOST};

    # ACME HTTP-01 challenges (mount a webroot at /var/www/acme when using certbot --webroot).
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme;
        default_type text/plain;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

# ---------------------------------------------------------------- ingest host
server {
    listen ${HS_TLS_PORT} ssl;
    http2 on;
    server_name ${HS_INGEST_HOST};
    set $hs_backend http://${HS_BACKEND_ADDR};

    ssl_certificate     /etc/nginx/certs/${HS_INGEST_CERT};
    ssl_certificate_key /etc/nginx/certs/${HS_INGEST_KEY};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    access_log off;
    client_max_body_size 16k;
    client_body_buffer_size 16k;
    client_header_buffer_size 1k;
    large_client_header_buffers 4 8k;
    client_body_timeout 10s;
    client_header_timeout 10s;
    keepalive_timeout 15s;
    send_timeout 10s;
    limit_conn hs_conn 50;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;

    # Decoy hits. If the backend cannot record one (5xx, timeout, unreachable), the edge keeps it in
    # the spool and answers exactly as the backend would, so no hit is lost during an outage and the
    # response never reveals one.
    location ~ ^/(${HS_DECOY_HIT_RE})/ {
        limit_req zone=hs_ingest burst=40 nodelay;
        limit_except GET HEAD POST { deny all; }
        proxy_pass $hs_backend;
        include /etc/nginx/hs_proxy_headers.conf;
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
        proxy_intercept_errors on;
        error_page 500 502 503 504 = @hs_capture_204;
    }

    location ~ ^/(${HS_DECOY_PX_RE})/ {
        limit_req zone=hs_ingest burst=40 nodelay;
        limit_except GET HEAD POST { deny all; }
        proxy_pass $hs_backend;
        include /etc/nginx/hs_proxy_headers.conf;
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
        proxy_intercept_errors on;
        error_page 500 502 503 504 = @hs_capture_gif;
    }

    location @hs_capture_204 {
        access_log /var/spool/honeyshield/ingest.jsonl hs_capture;
        return 204;
    }

    location @hs_capture_gif {
        access_log /var/spool/honeyshield/ingest.jsonl hs_capture;
        # the same 43-byte transparent GIF the backend returns
        empty_gif;
    }

    location ^~ /integrations/v1/ {
        limit_req zone=hs_hook burst=200 nodelay;
        limit_except GET POST { deny all; }
        proxy_pass $hs_backend;
        include /etc/nginx/hs_proxy_headers.conf;
        proxy_read_timeout 15s;
    }

    # Nothing else exists on this host: no API, docs, health or streaming.
    location / {
        return 404;
    }
}

# ---------------------------------------------------------------- control plane
server {
    listen ${HS_TLS_PORT} ssl;
    http2 on;
    server_name ${HS_CONTROL_HOST};
    set $hs_backend http://${HS_BACKEND_ADDR};

    ssl_certificate     /etc/nginx/certs/${HS_CONTROL_CERT};
    ssl_certificate_key /etc/nginx/certs/${HS_CONTROL_KEY};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    access_log off;
    client_max_body_size 1m;
    client_header_buffer_size 2k;
    large_client_header_buffers 4 16k;
    client_body_timeout 12s;
    client_header_timeout 12s;
    keepalive_timeout 65s;
    limit_conn hs_conn 100;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Only the addresses in HS_CONTROL_ALLOW_CIDRS may reach the console and API (403 for the rest);
    # the file is a comment when the list is empty. The backend checks the same list.
    include /etc/nginx/conf.d/hs-control-access.inc;

    # Ingest routes are not served on the operator host.
    location ~ ^/(${HS_DECOY_ALL_RE})/ {
        return 404;
    }

    location = /auth/login {
        limit_req zone=hs_login burst=5 nodelay;
        proxy_pass $hs_backend;
        include /etc/nginx/hs_proxy_headers.conf;
    }

    # Passkey sign-in (password check, then signature): the same edge budget as /auth/login.
    location ^~ /auth/passkey/login {
        limit_req zone=hs_login burst=5 nodelay;
        proxy_pass $hs_backend;
        include /etc/nginx/hs_proxy_headers.conf;
    }

    # Unauthenticated password reset: login-like edge limit in its own zone (the app adds
    # per-address limits).
    location ^~ /auth/password-reset/ {
        limit_req zone=hs_reset burst=5 nodelay;
        proxy_pass $hs_backend;
        include /etc/nginx/hs_proxy_headers.conf;
    }

    location = /api/v1/events/stream/sse {
        limit_req zone=hs_api burst=20 nodelay;
        proxy_pass $hs_backend;
        include /etc/nginx/hs_proxy_headers.conf;
        proxy_buffering off;
        proxy_cache off;
        proxy_set_header Connection '';
        chunked_transfer_encoding off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location = /api/v1/events/stream/ws {
        limit_req zone=hs_api burst=20 nodelay;
        proxy_pass $hs_backend;
        include /etc/nginx/hs_proxy_headers.conf;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Operator console (static files, same origin as the API).
    # Service-to-service endpoints (edge replay) are never reachable from outside.
    location ^~ /internal/ {
        return 404;
    }

    location ^~ /console/ {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /console/index.html;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    }

    location / {
        limit_req zone=hs_api burst=60 nodelay;
        proxy_pass $hs_backend;
        include /etc/nginx/hs_proxy_headers.conf;
        proxy_buffer_size 8k;
        proxy_buffers 8 8k;
        proxy_busy_buffers_size 16k;
        proxy_read_timeout 60s;
    }
}
