#!/bin/sh
# Sourced by the nginx entrypoint before the template step (20-envsubst-on-templates.sh), so the
# variables exported here are substituted into templates/default.conf.template.
#
#   HS_DECOY_LINK_PATH / HS_DECOY_PIXEL_PATH / HS_DECOY_COLLECT_PATH
#       decoy URL prefixes (default t, px, collect); must match the backend's DECOY_*_PATH.
#   HS_DECOY_LEGACY_PATHS
#       true (default): keep serving /t/, /px/ and /collect/ for decoys made before a change.
#   HS_CONTROL_ALLOW_CIDRS
#       addresses allowed to reach the operator host (console and API), comma- or space-separated
#       IPs/CIDRs. Empty (default): everyone. The ingest host always stays open.
#
# Any invalid value stops the container: a typo must not silently open or break the edge.

hs_fail() { echo "14-hs-edge-config.envsh: $*" >&2; exit 1; }

hs_path_ok() {
  printf '%s' "$1" | grep -Eq '^[a-z0-9][a-z0-9-]{0,30}(/[a-z0-9][a-z0-9-]{0,30}){0,2}$'
}

HS_DECOY_LINK_PATH="${HS_DECOY_LINK_PATH:-t}"
HS_DECOY_PIXEL_PATH="${HS_DECOY_PIXEL_PATH:-px}"
HS_DECOY_COLLECT_PATH="${HS_DECOY_COLLECT_PATH:-collect}"
HS_DECOY_LEGACY_PATHS="${HS_DECOY_LEGACY_PATHS:-true}"
for hs_p in "$HS_DECOY_LINK_PATH" "$HS_DECOY_PIXEL_PATH" "$HS_DECOY_COLLECT_PATH"; do
  hs_path_ok "$hs_p" || hs_fail "invalid decoy path '$hs_p' (1-3 segments of a-z, 0-9 and '-')"
done

hs_hit="$HS_DECOY_LINK_PATH|$HS_DECOY_COLLECT_PATH"
hs_px="$HS_DECOY_PIXEL_PATH"
case "$HS_DECOY_LEGACY_PATHS" in
  true|1|yes)
    [ "$HS_DECOY_LINK_PATH" = t ] || hs_hit="$hs_hit|t"
    [ "$HS_DECOY_COLLECT_PATH" = collect ] || hs_hit="$hs_hit|collect"
    [ "$HS_DECOY_PIXEL_PATH" = px ] || hs_px="$hs_px|px"
    ;;
  false|0|no) ;;
  *) hs_fail "HS_DECOY_LEGACY_PATHS must be true or false" ;;
esac
export HS_DECOY_HIT_RE="$hs_hit"
export HS_DECOY_PX_RE="$hs_px"
# The operator host never serves decoy or integration routes (original prefixes included).
export HS_DECOY_ALL_RE="$hs_hit|$hs_px|t|px|collect|integrations"

hs_access=/etc/nginx/conf.d/hs-control-access.inc
if [ -n "${HS_CONTROL_ALLOW_CIDRS:-}" ]; then
  : > "$hs_access"
  for hs_cidr in $(printf '%s' "$HS_CONTROL_ALLOW_CIDRS" | tr ',' ' '); do
    printf '%s' "$hs_cidr" | grep -Eq '^([0-9]{1,3}\.){3}[0-9]{1,3}(/[0-9]{1,2})?$|^[0-9A-Fa-f:]+(/[0-9]{1,3})?$' \
      || hs_fail "invalid HS_CONTROL_ALLOW_CIDRS entry '$hs_cidr'"
    printf 'allow %s;\n' "$hs_cidr" >> "$hs_access"
  done
  printf 'deny all;\n' >> "$hs_access"
  echo "14-hs-edge-config.envsh: operator host limited to: $HS_CONTROL_ALLOW_CIDRS"
else
  printf '# HS_CONTROL_ALLOW_CIDRS is empty: the operator host is open to every address.\n' > "$hs_access"
fi
echo "14-hs-edge-config.envsh: decoy paths /$HS_DECOY_LINK_PATH/ /$HS_DECOY_PIXEL_PATH/ /$HS_DECOY_COLLECT_PATH/ (legacy: $HS_DECOY_LEGACY_PATHS)"
unset hs_p hs_hit hs_px hs_access hs_cidr
